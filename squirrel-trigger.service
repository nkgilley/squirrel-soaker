# Run the Raspberry Pi GPIO, spray-video, diagnostics, and backlog HTTP service.
[Unit]
Description=Squirrel Soaker Solenoid Trigger Server
After=network.target
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
User=@PI_USER@
WorkingDirectory=@PI_APP_DIR@
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=@PI_APP_DIR@/device.env
Environment=BUTTON_PIN=27
Environment=BUTTON_ACTIVE_LOW=true
ExecStart=/usr/bin/python3 -u @PI_APP_DIR@/trigger_server.py
Restart=always
RestartSec=5
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
