[Unit]
Description=Squirrel Soaker Camera Capture Daemon
After=network.target squirrel-trigger.service
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/squirrel_soaker
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=/home/pi/squirrel_soaker/device.env
ExecStart=/usr/bin/python3 -u /home/pi/squirrel_soaker/capture.py
Restart=always
RestartSec=10
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
