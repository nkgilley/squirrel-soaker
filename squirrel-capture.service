[Unit]
Description=Squirrel Soaker Camera Capture Daemon
After=network.target squirrel-trigger.service
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
User=@PI_USER@
WorkingDirectory=@PI_APP_DIR@
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=@PI_APP_DIR@/device.env
ExecStart=/usr/bin/python3 -u @PI_APP_DIR@/capture.py
Restart=always
RestartSec=10
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
